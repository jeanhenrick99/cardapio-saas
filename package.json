{
  "name": "cardapio-saas",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @cardapio/api",
    "db:seed": "npm run db:seed -w @cardapio/api",
    "db:studio": "npm run db:studio -w @cardapio/api",
    "dev:api": "npm run dev -w @cardapio/api",
    "dev:agent": "npm run dev -w @cardapio/print-agent",
    "dev:web": "npm run dev -w @cardapio/web",
    "pair": "npm run pair -w @cardapio/print-agent --",
    "order": "npm run order -w @cardapio/api --",
    "pairing-code": "npm run pairing-code -w @cardapio/api --",
    "test-print": "npm run test-print -w @cardapio/print-agent",
    "test": "npm test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @cardapio/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
