DATABASE_URL="postgresql://cardapio:cardapio@localhost:5432/cardapio?schema=public"
PORT=8080
# Em produção atrás de proxy (Vercel/Render), use "true" para o limite de tentativas usar o IP real do cliente.
TRUST_PROXY=false

# Administrador(es) da plataforma: e-mails separados por vírgula. Acessam /admin e a base de qualquer restaurante (suporte).
# A senha só é usada para CRIAR a conta no primeiro "npm run db:seed"; depois pode ser removida.
# PLATFORM_ADMIN_EMAIL=voce@exemplo.com
# PLATFORM_ADMIN_PASSWORD=uma-senha-longa-com-12-ou-mais-caracteres
