generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  /// Contador para numerar os pedidos de cada restaurante (#0001, #0002...).
  lastOrderNumber Int      @default(0)
  createdAt       DateTime @default(now())

  // Vitrine do cardápio
  logoUrl           String?
  coverUrl          String?
  /// Liga/desliga o recebimento de pedidos ("Aberto agora" / "Fechado").
  acceptingOrders   Boolean @default(true)
  pickupMinutes     Int     @default(30)
  deliveryMinutes   Int     @default(45)
  /// Valor mínimo do pedido de delivery (em centavos). 0 = sem mínimo.
  minOrderCents     Int     @default(0)
  /// Quantidade de mesas do salão (o PDV mostra as mesas 1 a N).
  tableCount        Int     @default(0)
  /// Taxa de serviço sugerida no fechamento da conta (%). 0 = sem taxa.
  serviceFeePercent Int     @default(10)

  orders        Order[]
  printJobs     PrintJob[]
  agents        Agent[]
  pairingCodes  PairingCode[]
  memberships   Membership[]
  categories    Category[]
  products      Product[]
  images        Image[]
  tabs          Tab[]
  cashRegisters CashRegister[]
  invites       Invite[]
}

model User {
  id           String   @id @default(uuid())
  /// Sempre salvo em minúsculas.
  email        String   @unique
  name         String
  /// Formato: scrypt$N$r$p$salt$hash
  passwordHash String
  createdAt    DateTime @default(now())

  sessions       Session[]
  memberships    Membership[]
  passwordResets PasswordReset[]
}

/// Sessão de login. Como nos agentes, guardamos só o hash do token.
model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  OWNER
  STAFF
}

/// Liga usuários a restaurantes: um usuário pode ter vários restaurantes e vice-versa.
model Membership {
  userId       String
  restaurantId String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@index([restaurantId])
}

/// Um agente de impressão instalado em um PC do restaurante.
model Agent {
  id           String    @id @default(uuid())
  restaurantId String
  name         String
  /// Guardamos só o hash SHA-256 do token: um vazamento do banco não expõe credenciais.
  tokenHash    String    @unique
  version      String?
  printers     String[]
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

/// Código curto e temporário (ex.: K7P-2QX) para parear um agente sem digitar token.
model PairingCode {
  id           String    @id @default(uuid())
  restaurantId String
  codeHash     String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id
  restaurantId    String
  number          Int
  type            String
  totalCents      Int
  /// Snapshot completo do pedido (itens, adicionais, cliente) no formato do pacote shared.
  data            Json
  createdAt       DateTime    @default(now())
  /// Etapa do pedido (Kanban). As regras de mudança ficam em packages/shared/src/order-status.ts.
  status          OrderStatus @default(RECEIVED)
  statusChangedAt DateTime    @default(now())

  /// Conta (mesa ou comanda) à qual o pedido pertence. Delivery e retirada não têm conta.
  tabId          String?
  /// Cópia de data.paymentMethod em coluna, para somar nos relatórios sem ler o JSON.
  paymentMethod  String?
  /// Caixa aberto quando o pedido avulso (sem conta) foi feito.
  cashRegisterId String?

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tab          Tab?          @relation(fields: [tabId], references: [id])
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  printJobs    PrintJob[]

  @@unique([restaurantId, number])
  @@index([tabId])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([cashRegisterId])
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELED
}

enum PrintJobStatus {
  QUEUED
  SENT
  PRINTED
  FAILED
}

/// Outbox de impressão: o job só sai de QUEUED/SENT quando o agente confirma.
model PrintJob {
  id           String         @id @default(uuid())
  restaurantId String
  orderId      String
  status       PrintJobStatus @default(QUEUED)
  /// Quantas vezes o job foi enviado ao agente (reenvios após reconexão).
  sendCount    Int            @default(0)
  /// Resultado por impressora, vindo do ACK do agente.
  printers     Json?
  createdAt    DateTime       @default(now())
  sentAt       DateTime?
  completedAt  DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
}

// ---------- Cardápio ----------

model Category {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  position     Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([restaurantId, position])
}

model Product {
  id           String   @id @default(uuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  priceCents   Int
  /// Setor de produção: decide em qual impressora o item sai (cozinha, bar...).
  sector       String   @default("cozinha")
  position     Int      @default(0)
  /// Desativado = não aparece no cardápio público (ex.: acabou o estoque).
  active       Boolean  @default(true)
  /// Aparece na faixa "Destaques" do topo do cardápio.
  featured     Boolean  @default(false)
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  optionGroups OptionGroup[]

  @@index([restaurantId, categoryId, position])
}

/// Grupo de complementos de um produto, ex.: "Escolha o ponto" (mín 1, máx 1)
/// ou "Adicionais" (mín 0, máx 5).
model OptionGroup {
  id        String @id @default(uuid())
  productId String
  name      String
  minSelect Int    @default(0)
  maxSelect Int    @default(1)
  position  Int    @default(0)

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  options Option[]

  @@index([productId, position])
}

model Option {
  id         String  @id @default(uuid())
  groupId    String
  name       String
  priceCents Int     @default(0)
  position   Int     @default(0)
  active     Boolean @default(true)

  group OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, position])
}

/// Fotos enviadas pelo restaurante (produtos, logo e capa).
/// Ficam no próprio banco (já comprimidas no navegador, ~100 KB) porque o disco
/// do servidor gratuito é apagado a cada deploy. O acesso passa por src/images/storage.ts,
/// então trocar por um serviço de arquivos (S3, R2, Cloudinary) mexe em um lugar só.
model Image {
  id           String   @id @default(uuid())
  restaurantId String
  contentType  String
  size         Int
  data         Bytes
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

enum TabKind {
  MESA
  COMANDA
}

enum TabStatus {
  OPEN
  CLOSED
}

/// Conta aberta de uma mesa ou comanda: soma os pedidos até o fechamento.
/// Regra garantida pelo banco (índice parcial "Tab_one_open_per_number", criado na
/// migration _tabs): no máximo UMA conta aberta por (restaurante, tipo, número).
/// ATENÇÃO: o Prisma não conhece esse índice; ao gerar migrations novas, confira se
/// ele não aparece num DROP INDEX e remova essa linha se aparecer.
model Tab {
  id              String    @id @default(uuid())
  restaurantId    String
  kind            TabKind
  number          String
  status          TabStatus @default(OPEN)
  openedAt        DateTime  @default(now())
  openedBy        String?
  closedAt        DateTime?
  closedBy        String?
  /// Resumo das formas usadas ("Pix" ou "Pix + Dinheiro"). Os valores ficam em TabPayment.
  paymentMethod   String?
  subtotalCents   Int?
  serviceFeeCents Int?
  discountCents   Int?
  totalCents      Int?
  /// Caixa aberto quando a conta foi fechada (paga).
  cashRegisterId  String?

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cashRegister CashRegister? @relation(fields: [cashRegisterId], references: [id])
  orders       Order[]
  payments     TabPayment[]

  @@index([restaurantId, status])
  @@index([restaurantId, closedAt])
  @@index([cashRegisterId])
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementKind {
  SANGRIA
  SUPRIMENTO
}

/// Caixa do PDV: aberto com troco, recebe vendas, sangrias e suprimentos, e é conferido no fechamento.
/// Só um caixa aberto por restaurante: índice único PARCIAL criado na migração (o Prisma não o
/// representa; ao gerar migrações novas, confira se nenhuma apaga "CashRegister_one_open").
model CashRegister {
  id                String             @id @default(uuid())
  restaurantId      String
  status            CashRegisterStatus @default(OPEN)
  openedAt          DateTime           @default(now())
  openedBy          String
  openingCents      Int
  closedAt          DateTime?
  closedBy          String?
  countedCents      Int?
  expectedCashCents Int?
  /// Resumo gravado no fechamento (CashSummary do pacote shared): não muda se um pedido for cancelado depois.
  summary           Json?
  notes             String?

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  movements  CashMovement[]
  orders     Order[]
  tabs       Tab[]

  @@index([restaurantId, openedAt])
}

model CashMovement {
  id          String           @id @default(uuid())
  registerId  String
  kind        CashMovementKind
  amountCents Int
  reason      String
  createdAt   DateTime         @default(now())
  createdBy   String

  register CashRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  @@index([registerId])
}

/// Pagamento de uma conta. Conta dividida = vários pagamentos (ex.: parte no Pix, parte em dinheiro).
model TabPayment {
  id          String   @id @default(uuid())
  tabId       String
  method      String
  amountCents Int
  createdAt   DateTime @default(now())
  createdBy   String

  tab Tab @relation(fields: [tabId], references: [id], onDelete: Cascade)

  @@index([tabId])
}

/// Convite para a equipe: link de uso único (o banco guarda só o hash do token).
model Invite {
  id           String    @id @default(uuid())
  restaurantId String
  /// Sempre em minúsculas. Quem aceita entra com este e-mail.
  email        String
  name         String
  role         Role      @default(STAFF)
  tokenHash    String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  createdBy    String
  acceptedAt   DateTime?
  revokedAt    DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

/// Link de redefinição de senha gerado pelo dono para um funcionário.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  createdBy String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
