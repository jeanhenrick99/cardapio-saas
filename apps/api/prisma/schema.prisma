generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  /// Contador para numerar os pedidos de cada restaurante (#0001, #0002...).
  lastOrderNumber Int      @default(0)
  createdAt       DateTime @default(now())

  // Vitrine do cardápio
  logoUrl         String?
  coverUrl        String?
  /// Liga/desliga o recebimento de pedidos ("Aberto agora" / "Fechado").
  acceptingOrders Boolean  @default(true)
  pickupMinutes   Int      @default(30)
  deliveryMinutes Int      @default(45)
  /// Valor mínimo do pedido de delivery (em centavos). 0 = sem mínimo.
  minOrderCents   Int      @default(0)

  orders       Order[]
  printJobs    PrintJob[]
  agents       Agent[]
  pairingCodes PairingCode[]
  memberships  Membership[]
  categories   Category[]
  products     Product[]
  images       Image[]
}

model User {
  id           String   @id @default(uuid())
  /// Sempre salvo em minúsculas.
  email        String   @unique
  name         String
  /// Formato: scrypt$N$r$p$salt$hash
  passwordHash String
  createdAt    DateTime @default(now())

  sessions    Session[]
  memberships Membership[]
}

/// Sessão de login. Como nos agentes, guardamos só o hash do token.
model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  OWNER
  STAFF
}

/// Liga usuários a restaurantes: um usuário pode ter vários restaurantes e vice-versa.
model Membership {
  userId       String
  restaurantId String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([userId, restaurantId])
  @@index([restaurantId])
}

/// Um agente de impressão instalado em um PC do restaurante.
model Agent {
  id           String    @id @default(uuid())
  restaurantId String
  name         String
  /// Guardamos só o hash SHA-256 do token: um vazamento do banco não expõe credenciais.
  tokenHash    String    @unique
  version      String?
  printers     String[]
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

/// Código curto e temporário (ex.: K7P-2QX) para parear um agente sem digitar token.
model PairingCode {
  id           String    @id @default(uuid())
  restaurantId String
  codeHash     String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Order {
  id           String   @id
  restaurantId String
  number       Int
  type         String
  totalCents   Int
  /// Snapshot completo do pedido (itens, adicionais, cliente) no formato do pacote shared.
  data         Json
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  printJobs  PrintJob[]

  @@unique([restaurantId, number])
}

enum PrintJobStatus {
  QUEUED
  SENT
  PRINTED
  FAILED
}

/// Outbox de impressão: o job só sai de QUEUED/SENT quando o agente confirma.
model PrintJob {
  id           String         @id @default(uuid())
  restaurantId String
  orderId      String
  status       PrintJobStatus @default(QUEUED)
  /// Quantas vezes o job foi enviado ao agente (reenvios após reconexão).
  sendCount    Int            @default(0)
  /// Resultado por impressora, vindo do ACK do agente.
  printers     Json?
  createdAt    DateTime       @default(now())
  sentAt       DateTime?
  completedAt  DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
}

// ---------- Cardápio ----------

model Category {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  position     Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([restaurantId, position])
}

model Product {
  id           String   @id @default(uuid())
  restaurantId String
  categoryId   String
  name         String
  description  String?
  priceCents   Int
  /// Setor de produção: decide em qual impressora o item sai (cozinha, bar...).
  sector       String   @default("cozinha")
  position     Int      @default(0)
  /// Desativado = não aparece no cardápio público (ex.: acabou o estoque).
  active       Boolean  @default(true)
  /// Aparece na faixa "Destaques" do topo do cardápio.
  featured     Boolean  @default(false)
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  optionGroups OptionGroup[]

  @@index([restaurantId, categoryId, position])
}

/// Grupo de complementos de um produto, ex.: "Escolha o ponto" (mín 1, máx 1)
/// ou "Adicionais" (mín 0, máx 5).
model OptionGroup {
  id        String @id @default(uuid())
  productId String
  name      String
  minSelect Int    @default(0)
  maxSelect Int    @default(1)
  position  Int    @default(0)

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  options Option[]

  @@index([productId, position])
}

model Option {
  id         String  @id @default(uuid())
  groupId    String
  name       String
  priceCents Int     @default(0)
  position   Int     @default(0)
  active     Boolean @default(true)

  group OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, position])
}

/// Fotos enviadas pelo restaurante (produtos, logo e capa).
/// Ficam no próprio banco (já comprimidas no navegador, ~100 KB) porque o disco
/// do servidor gratuito é apagado a cada deploy. O acesso passa por src/images/storage.ts,
/// então trocar por um serviço de arquivos (S3, R2, Cloudinary) mexe em um lugar só.
model Image {
  id           String   @id @default(uuid())
  restaurantId String
  contentType  String
  size         Int
  data         Bytes
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}
